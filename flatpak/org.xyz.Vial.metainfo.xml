  <name>Vial</name>
  <summary>Open-source cross-platform GUI for configuring your keyboard in real time</summary>
  <description>
    <p>
      Vial is an open-source cross-platform (Windows, Linux and Mac) GUI and a QMK fork
      for configuring your keyboard in real time.
    </p>
    <p>Features include:</p>
    <ul>
      <li>Real-time keyboard configuration</li>
      <li>Key remapping and macro support</li>
      <li>Layer management</li>
      <li>Cross-platform support</li>
    </ul>
  </description>
  <launchable type="desktop-id">org.xyz.Vial.desktop</launchable>
